# Temporary demo linking; set false to require the existing Firebase login.
DEMO_AUTH_MODE=true

# Server-side manual test activation; keep false for normal live deployments.
WHATSAPP_SETUP_ALLOW_MANUAL_TEST=false
# Enable real Meta validation only after secret references are mounted.
WHATSAPP_SETUP_LIVE_TESTS=false
# Comma-separated names of mounted secret environment variables (never their values).
WHATSAPP_TOKEN_SECRET_NAMES=
# Approved test recipients, international digits, comma-separated.
WHATSAPP_SETUP_TEST_RECIPIENTS=

# Bind each business to its mounted secret name, e.g. {"demo-eats":"TANY_EATS_TOKEN"}
WHATSAPP_TOKEN_SECRET_BINDINGS={}

# Product workspace destination; contains no service credential.
TANY_PRODUCT_DASHBOARD_URL=https://app.tany.in/dashboard

# Server-only shared secret (32+ characters) for the scheduled automation worker.
AUTOMATION_WORKER_SECRET=

# Disabled: send native single-product cards until Meta product-list support is retried.
WHATSAPP_PRODUCT_LIST_ENABLED=false

